{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    "noEmit": true,
    // @aquadesk/game-spec(워크스페이스, TS 소스)는 명시적 '.ts' 확장 import를 쓴다.
    // bundler 해석 + noEmit 환경에서 그 소스를 직접 타입체크하려면 이 플래그가 필요하다.
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@aquadesk/game-spec": ["../../packages/game-spec/src/index.ts"],
      "@aquadesk/game-spec/*": ["../../packages/game-spec/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
