# Aqua Desk — 환경변수 예시 (키 이름만, 값 없이)
# 실제 값은 .env.local 등에 채우고 절대 커밋하지 않는다 (.gitignore 처리됨).
# 자세한 시크릿 경계 규약은 GUARDRAILS.md §7, 설계서/05 §5 참조.

# --- 클라이언트 노출 허용 (NEXT_PUBLIC_*: 빌드 시 클라 번들에 인라인됨, anon 한정) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 서버 전용 시크릿 ---
# SUPABASE_SERVICE_ROLE_KEY: Edge Function 환경변수 전용.
# 절대 금지 — 클라이언트 번들/Next public env/로그/스냅샷/딥링크 어디에도 노출하지 않는다.
# NEXT_PUBLIC_ 프리픽스를 절대 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
